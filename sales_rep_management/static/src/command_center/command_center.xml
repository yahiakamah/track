<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sales_rep_management.CommandCenter">
        <div class="o_scc">
            <div class="o_scc_head">
                <div class="o_scc_title">
                    <i class="fa fa-cubes" title="Sales Command Center"/>
                    <div>
                        <h1>Sales Command Center</h1>
                        <span t-if="state.data and !state.data.empty"><t t-esc="state.data.rep_count"/> representatives · <t t-esc="state.data.date_from"/> → <t t-esc="state.data.date_to"/></span>
                    </div>
                </div>
                <div class="o_scc_filters">
                    <div class="o_scc_pills">
                        <button class="btn" t-on-click="() => this.setPeriod('today')">Today</button>
                        <button class="btn" t-on-click="() => this.setPeriod('week')">Week</button>
                        <button class="btn" t-on-click="() => this.setPeriod('month')">Month</button>
                        <button class="btn" t-on-click="() => this.setPeriod('quarter')">Quarter</button>
                        <button class="btn" t-on-click="() => this.setPeriod('year')">Year</button>
                    </div>
                    <input type="date" class="form-control" t-model="state.date_from" t-on-change="() => this.load()"/>
                    <input type="date" class="form-control" t-model="state.date_to" t-on-change="() => this.load()"/>
                    <select class="form-select" t-att-value="state.rep_id" t-on-change="(ev) => this.onFilter('rep_id', ev)">
                        <option value="">All representatives</option>
                        <option t-foreach="state.filters.reps" t-as="r" t-key="r.id" t-att-value="r.id" t-att-selected="this.isSel('rep_id', r.id)"><t t-esc="r.name"/></option>
                    </select>
                    <select class="form-select" t-att-value="state.supervisor_id" t-on-change="(ev) => this.onFilter('supervisor_id', ev)">
                        <option value="">All teams</option>
                        <option t-foreach="state.filters.supervisors" t-as="r" t-key="r.id" t-att-value="r.id" t-att-selected="this.isSel('supervisor_id', r.id)">Team <t t-esc="r.name"/></option>
                    </select>
                    <select class="form-select" t-att-value="state.area_id" t-on-change="(ev) => this.onFilter('area_id', ev)">
                        <option value="">All areas</option>
                        <option t-foreach="state.filters.areas" t-as="a" t-key="a.id" t-att-value="a.id" t-att-selected="this.isSel('area_id', a.id)"><t t-esc="a.name"/></option>
                    </select>
                </div>
            </div>

            <div t-if="state.loading" class="o_scc_loading"><i class="fa fa-circle-o-notch fa-spin fa-2x" title="Loading"/></div>
            <div t-elif="state.data.empty" class="o_scc_empty">No representative matches these filters.</div>
            <t t-else="">
                <div class="o_scc_grid">
                    <div t-foreach="state.data.sections" t-as="s" t-key="s.key"
                         t-attf-class="o_scc_card #{s.alert ? 'o_scc_alert' : ''}" t-attf-style="--accent: #{s.color}"
                         t-on-click="() => this.open(s)" role="button" tabindex="0">
                        <div class="o_scc_orb"><i t-attf-class="fa #{s.icon}" t-att-title="s.title"/></div>
                        <div class="o_scc_card_title"><t t-esc="s.title"/></div>
                        <div class="o_scc_value"><t t-esc="this.display(s)"/></div>
                        <div class="o_scc_sub"><t t-esc="s.sub"/></div>
                        <div t-if="s.trend !== undefined and s.trend !== null" t-attf-class="o_scc_trend #{s.trend >= 0 ? 'up' : 'down'}">
                            <i t-attf-class="fa #{s.trend >= 0 ? 'fa-arrow-up' : 'fa-arrow-down'}" title="Trend"/> <t t-esc="this.abs(s.trend)"/>% vs previous period
                        </div>
                        <div t-if="s.extra" class="o_scc_extra">
                            <span t-foreach="s.extra" t-as="e" t-key="e_index"><t t-esc="e[0]"/>: <b><t t-esc="this.extraValue(e[1])"/></b></span>
                        </div>
                    </div>
                </div>

                <div class="o_scc_bottom">
                    <div class="o_scc_panel">
                        <h3><i class="fa fa-trophy" title="Leaderboard"/> Representatives</h3>
                        <div t-foreach="state.data.leaderboard" t-as="r" t-key="r.id" class="o_scc_row" t-on-click="() => this.openRep(r)" role="button">
                            <span class="o_scc_rank"><t t-esc="r_index + 1"/></span>
                            <span class="o_scc_name"><t t-esc="r.name"/></span>
                            <div class="o_scc_bar"><div t-attf-style="width: #{r.bar}%"/></div>
                            <span class="o_scc_num"><t t-esc="this.money(r.sales)"/></span>
                            <span class="o_scc_chip" title="Journey compliance"><t t-esc="r.compliance"/>%</span>
                        </div>
                    </div>
                    <div class="o_scc_panel" t-if="state.data.areas.length">
                        <h3><i class="fa fa-globe" title="Areas"/> Areas</h3>
                        <div t-foreach="state.data.areas" t-as="a" t-key="a.id" class="o_scc_row" t-on-click="() => this.openArea(a)" role="button">
                            <span class="o_scc_name"><t t-esc="a.name"/> <small>(<t t-esc="a.reps"/>)</small></span>
                            <span class="o_scc_num"><t t-esc="this.money(a.sales)"/></span>
                            <span class="o_scc_num muted"><t t-esc="this.money(a.collections)"/></span>
                            <span class="o_scc_chip"><t t-esc="a.compliance"/>%</span>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
