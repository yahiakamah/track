<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Areas ============ -->
    <record id="view_sales_area_list" model="ir.ui.view">
        <field name="name">sales.area.list</field>
        <field name="model">sales.area</field>
        <field name="arch" type="xml">
            <list>
                <field name="complete_name"/>
                <field name="code"/>
                <field name="sales_rep_ids" widget="many2many_tags"/>
                <field name="partner_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_sales_area_form" model="ir.ui.view">
        <field name="name">sales.area.form</field>
        <field name="model">sales.area</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="sales_rep_ids" widget="many2many_tags"/>
                            <field name="partner_count"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sales_area" model="ir.actions.act_window">
        <field name="name">Sales Areas</field>
        <field name="res_model">sales.area</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_partner_form_sales_area" model="ir.ui.view">
        <field name="name">res.partner.form.sales.area</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="sales_area_id"/>
            </xpath>
        </field>
    </record>
    <record id="view_partner_search_sales_area" model="ir.ui.view">
        <field name="name">res.partner.search.sales.area</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <filter name="group_sales_area" string="Sales Area" context="{'group_by': 'sales_area_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_representative_form_performance" model="ir.ui.view">
        <field name="name">sales.representative.form.performance</field>
        <field name="model">sales.representative</field>
        <field name="inherit_id" ref="sales_rep_management.view_sales_representative_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='territories']" position="inside">
                <group string="Sales Areas">
                    <field name="sales_area_ids" widget="many2many_tags" nolabel="1" colspan="2"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ============ Tasks ============ -->
    <record id="view_sales_rep_task_list" model="ir.ui.view">
        <field name="name">sales.rep.task.list</field>
        <field name="model">sales.rep.task</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state in ('done', 'cancelled')" multi_edit="1">
                <field name="priority" widget="priority" optional="show"/>
                <field name="date_deadline"/>
                <field name="name"/>
                <field name="task_type"/>
                <field name="sales_rep_id"/>
                <field name="partner_id"/>
                <field name="proof_type" optional="hide"/>
                <field name="amount_due" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'failed'" decoration-info="state == 'in_progress'"/>
            </list>
        </field>
    </record>
    <record id="view_sales_rep_task_kanban" model="ir.ui.view">
        <field name="name">sales.rep.task.kanban</field>
        <field name="model">sales.rep.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <div><field name="partner_id"/></div>
                        <div class="text-muted"><field name="sales_rep_id"/></div>
                        <footer>
                            <field name="priority" widget="priority"/>
                            <field name="date_deadline" widget="date" decoration-danger="is_overdue"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_sales_rep_task_form" model="ir.ui.view">
        <field name="name">sales.rep.task.form</field>
        <field name="model">sales.rep.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start" type="object" invisible="state != 'new'"/>
                    <button name="action_done" string="Mark Done" type="object" class="btn-primary" invisible="state not in ('new', 'in_progress')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset" string="Reopen" type="object" invisible="state not in ('done', 'failed', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Shelf photo of the new range"/></h1></div>
                    <group>
                        <group>
                            <field name="task_type"/>
                            <field name="sales_rep_id"/>
                            <field name="partner_id"/>
                            <field name="route_id"/>
                        </group>
                        <group>
                            <field name="date_deadline"/>
                            <field name="priority" widget="priority"/>
                            <field name="proof_type"/>
                            <field name="amount_due" invisible="not amount_due"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="source" invisible="source == 'manual'"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Instructions for the representative"/>
                    <group string="Result" invisible="state in ('new',)">
                        <field name="result_note"/>
                        <field name="proof_image" widget="image" class="oe_avatar" invisible="not proof_image"/>
                        <field name="done_date"/>
                        <field name="latitude" invisible="not latitude"/>
                        <field name="longitude" invisible="not longitude"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_sales_rep_task_search" model="ir.ui.view">
        <field name="name">sales.rep.task.search</field>
        <field name="model">sales.rep.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sales_rep_id"/>
                <field name="partner_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('new', 'in_progress'))]"/>
                <filter name="overdue" string="Overdue" domain="[('state', 'in', ('new', 'in_progress')), ('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="today" string="Due Today" domain="[('date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="date" string="Due Date" date="date_deadline"/>
                <group expand="0" string="Group By">
                    <filter name="group_rep" string="Representative" context="{'group_by': 'sales_rep_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'task_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_sales_rep_task" model="ir.actions.act_window">
        <field name="name">Rep Tasks</field>
        <field name="res_model">sales.rep.task</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <!-- ============ Targets ============ -->
    <record id="view_sales_rep_target_list" model="ir.ui.view">
        <field name="name">sales.rep.target.list</field>
        <field name="model">sales.rep.target</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="scope"/>
                <field name="sales_rep_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="score" widget="progressbar"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>
    <record id="view_sales_rep_target_form" model="ir.ui.view">
        <field name="name">sales.rep.target.form</field>
        <field name="model">sales.rep.target</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object" invisible="state != 'approved'"/>
                    <button name="action_draft" string="Back to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. November targets"/></h1></div>
                    <group>
                        <group>
                            <field name="scope" readonly="state != 'draft'"/>
                            <field name="sales_rep_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'draft'"/>
                            <field name="date_to" readonly="state != 'draft'"/>
                            <field name="achievement_cap"/>
                            <field name="score" widget="progressbar"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state == 'closed'">
                        <list editable="bottom">
                            <field name="kpi_type"/>
                            <field name="product_category_id" required="kpi_type == 'category_sales'" invisible="kpi_type != 'category_sales'"/>
                            <field name="target_value"/>
                            <field name="weight"/>
                            <field name="actual_value"/>
                            <field name="achievement" widget="progressbar"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_sales_rep_target" model="ir.actions.act_window">
        <field name="name">Targets</field>
        <field name="res_model">sales.rep.target</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ KPI history ============ -->
    <record id="view_sales_rep_kpi_snapshot_list" model="ir.ui.view">
        <field name="name">sales.rep.kpi.snapshot.list</field>
        <field name="model">sales.rep.kpi.snapshot</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="sales_rep_id"/>
                <field name="sales_value" sum="Total"/>
                <field name="collection_value" sum="Total"/>
                <field name="orders" sum="Total"/>
                <field name="planned_visits" sum="Total"/>
                <field name="visited" sum="Total"/>
                <field name="compliance" avg="Average"/>
                <field name="strike_rate" avg="Average"/>
                <field name="drop_size" avg="Average"/>
                <field name="new_customers" sum="Total"/>
                <field name="task_completion" avg="Average"/>
                <field name="returns_value" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_sales_rep_kpi_snapshot_pivot" model="ir.ui.view">
        <field name="name">sales.rep.kpi.snapshot.pivot</field>
        <field name="model">sales.rep.kpi.snapshot</field>
        <field name="arch" type="xml">
            <pivot string="Rep KPIs">
                <field name="sales_rep_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="sales_value" type="measure"/>
                <field name="collection_value" type="measure"/>
                <field name="visited" type="measure"/>
                <field name="planned_visits" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_sales_rep_kpi_snapshot_graph" model="ir.ui.view">
        <field name="name">sales.rep.kpi.snapshot.graph</field>
        <field name="model">sales.rep.kpi.snapshot</field>
        <field name="arch" type="xml">
            <graph string="Rep KPIs" type="line">
                <field name="date" interval="day"/>
                <field name="sales_value" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_sales_rep_kpi_snapshot_search" model="ir.ui.view">
        <field name="name">sales.rep.kpi.snapshot.search</field>
        <field name="model">sales.rep.kpi.snapshot</field>
        <field name="arch" type="xml">
            <search>
                <field name="sales_rep_id"/>
                <field name="supervisor_id" string="Team (supervisor)"/>
                <filter name="date" string="Date" date="date"/>
                <group expand="0" string="Group By">
                    <filter name="group_rep" string="Representative" context="{'group_by': 'sales_rep_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'supervisor_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_sales_rep_kpi_snapshot" model="ir.actions.act_window">
        <field name="name">KPI History</field>
        <field name="res_model">sales.rep.kpi.snapshot</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

    <!-- ============ Menus ============ -->
    <menuitem id="menu_sales_rep_tasks" name="Tasks" parent="sales_rep_management.menu_sales_rep_operations"
              action="action_sales_rep_task" sequence="12"/>
    <menuitem id="menu_sales_rep_targets" name="Targets" parent="sales_rep_management.menu_sales_rep_planning"
              action="action_sales_rep_target" sequence="20"/>
    <menuitem id="menu_sales_rep_kpi_history" name="KPI History" parent="sales_rep_management.menu_sales_rep_reports"
              action="action_sales_rep_kpi_snapshot" sequence="1"/>
    <menuitem id="menu_sales_area" name="Sales Areas" parent="sales_rep_management.menu_sales_rep_config"
              action="action_sales_area" sequence="5"/>

    <!-- ============ Crons ============ -->
    <record id="cron_overdue_collection_tasks" model="ir.cron">
        <field name="name">Rep Tasks: overdue collection tasks for today's routes</field>
        <field name="model_id" ref="model_sales_rep_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_overdue_collection_tasks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="cron_kpi_snapshot" model="ir.cron">
        <field name="name">Rep KPIs: daily snapshot</field>
        <field name="model_id" ref="model_sales_rep_kpi_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_snapshot()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
