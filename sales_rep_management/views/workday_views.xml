<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sales_rep_workday_list" model="ir.ui.view">
        <field name="name">sales.rep.workday.list</field>
        <field name="model">sales.rep.workday</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="start_source == 'visit' or end_source == 'visit'" decoration-muted="not end_time">
                <field name="date"/>
                <field name="sales_rep_id"/>
                <field name="supervisor_id" optional="show"/>
                <field name="start_time"/>
                <field name="start_source" optional="show"/>
                <field name="end_time"/>
                <field name="end_source" optional="show"/>
                <field name="duration_hours" widget="float_time" sum="Total"/>
                <field name="visit_count" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_sales_rep_workday_search" model="ir.ui.view">
        <field name="name">sales.rep.workday.search</field>
        <field name="model">sales.rep.workday</field>
        <field name="arch" type="xml">
            <search>
                <field name="sales_rep_id"/>
                <field name="supervisor_id"/>
                <filter name="today" string="Today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="no_button" string="Without Start/End button" domain="['|', ('start_source', '=', 'visit'), ('end_source', '=', 'visit')]"/>
                <filter name="open" string="Not Ended" domain="[('start_time', '!=', False), ('end_time', '=', False)]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group expand="0" string="Group By">
                    <filter name="group_rep" string="Representative" context="{'group_by': 'sales_rep_id'}"/>
                    <filter name="group_week" string="Week" context="{'group_by': 'date:week'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_sales_rep_workday_pivot" model="ir.ui.view">
        <field name="name">sales.rep.workday.pivot</field>
        <field name="model">sales.rep.workday</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="sales_rep_id" type="row"/>
                <field name="date" interval="week" type="col"/>
                <field name="duration_hours" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_sales_rep_workday" model="ir.actions.act_window">
        <field name="name">Working Days</field>
        <field name="res_model">sales.rep.workday</field>
        <field name="view_mode">list,pivot</field>
    </record>
    <record id="cron_workday_fill_from_visits" model="ir.cron">
        <field name="name">Rep working days: fill from first / last visit</field>
        <field name="model_id" ref="model_sales_rep_workday"/>
        <field name="state">code</field>
        <field name="code">model._cron_fill_from_visits()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <menuitem id="menu_sales_rep_workday" name="Working Days" parent="sales_rep_management.menu_sales_rep_reports"
              action="action_sales_rep_workday" sequence="45" groups="sales_rep_management.group_sales_supervisor"/>
</odoo>
