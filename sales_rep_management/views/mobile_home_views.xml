<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Representative: mobile home grid -->
    <record id="view_sales_representative_form_home_tiles" model="ir.ui.view">
        <field name="name">sales.representative.form.home.tiles</field>
        <field name="model">sales.representative</field>
        <field name="inherit_id" ref="sales_rep_management.view_sales_representative_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='custody']" position="after">
                <page string="Mobile Home" name="mobile_home">
                    <div class="text-muted mb-2">
                        Icons shown on the app's home screen, in this order. Leave empty for the default set.
                        Icons whose access right is off (e.g. Stock without "Storage Page") are hidden automatically.
                    </div>
                    <button name="action_reset_home_tiles" string="Load Default Tiles" type="object" class="btn-secondary mb-2"/>
                    <field name="home_tile_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="tile"/>
                        </list>
                    </field>
                    <group string="Mobile Access" name="mobile_access">
                        <group>
                            <field name="mobile_device_model"/>
                            <field name="mobile_device_id" groups="base.group_no_one"/>
                            <field name="mobile_last_seen"/>
                            <field name="mobile_token_expiry"/>
                        </group>
                        <group>
                            <button name="action_revoke_mobile_access" type="object" string="Revoke Mobile Access"
                                    class="btn-danger" icon="fa-ban" groups="sales_rep_management.group_sales_manager"
                                    confirm="The phone of this representative will be signed out now. Continue?"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Request types -->
    <record id="view_dept_request_type_list" model="ir.ui.view">
        <field name="name">sales.rep.dept.request.type.list</field>
        <field name="model">sales.rep.dept.request.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="department_id"/>
                <field name="approver_id"/>
                <field name="needs_amount"/>
                <field name="needs_dates"/>
                <field name="needs_vehicle"/>
                <field name="needs_customer"/>
                <field name="service_type_id" optional="hide"/>
                <field name="icon" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_dept_request_type" model="ir.actions.act_window">
        <field name="name">Request Types</field>
        <field name="res_model">sales.rep.dept.request.type</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Requests -->
    <record id="view_dept_request_list" model="ir.ui.view">
        <field name="name">sales.rep.dept.request.list</field>
        <field name="model">sales.rep.dept.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'submitted'" decoration-warning="state == 'info'" decoration-muted="state in ('cancelled', 'done')">
                <field name="name"/>
                <field name="create_date" string="Date"/>
                <field name="sales_rep_id"/>
                <field name="type_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="approver_id"/>
                <field name="state" widget="badge" decoration-success="state in ('approved', 'done')" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>
    <record id="view_dept_request_form" model="ir.ui.view">
        <field name="name">sales.rep.dept.request.form</field>
        <field name="model">sales.rep.dept.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state not in ('submitted', 'info')"/>
                    <button name="action_request_info" string="Ask for Info" type="object" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state not in ('submitted', 'info')"/>
                    <button name="action_done" string="Mark Done" type="object" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('submitted', 'info')"/>
                    <field name="state" widget="statusbar" statusbar_visible="submitted,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="type_id" readonly="state != 'submitted'"/>
                            <field name="sales_rep_id" readonly="1"/>
                            <field name="department_id"/>
                            <field name="approver_id"/>
                        </group>
                        <group>
                            <field name="amount" invisible="not amount and type_code != 'advance'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="type_code" invisible="1"/>
                            <field name="date_from" invisible="not date_from and type_code != 'mission'"/>
                            <field name="date_to" invisible="not date_to and type_code != 'mission'"/>
                            <field name="vehicle_id"/>
                            <field name="partner_id" invisible="not partner_id and type_code != 'customer_change'"/>
                            <field name="service_log_id" invisible="not service_log_id"/>
                        </group>
                    </group>
                    <group string="Request">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Answer to Representative">
                        <field name="response" nolabel="1" colspan="2" placeholder="Required to reject or to ask for more information"/>
                    </group>
                    <field name="attachment" widget="image" class="oe_avatar" invisible="not attachment"/>
                    <group invisible="not decided_by">
                        <field name="decided_by"/>
                        <field name="decided_date"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_dept_request_search" model="ir.ui.view">
        <field name="name">sales.rep.dept.request.search</field>
        <field name="model">sales.rep.dept.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="sales_rep_id"/>
                <field name="type_id"/>
                <filter name="to_decide" string="To Decide" domain="[('state', '=', 'submitted')]"/>
                <filter name="my_approval" string="My Approvals" domain="[('approver_id', '=', uid), ('state', '=', 'submitted')]"/>
                <filter name="waiting_rep" string="Waiting for Rep" domain="[('state', '=', 'info')]"/>
                <separator/>
                <filter name="customer" string="Customer Complaints &amp; Requests" domain="[('category', '=', 'customer')]"/>
                <filter name="internal" string="Department Requests" domain="[('category', '=', 'internal')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_rep" string="Representative" context="{'group_by': 'sales_rep_id'}"/>
                    <filter name="group_dept" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dept_request" model="ir.actions.act_window">
        <field name="name">Department Requests</field>
        <field name="res_model">sales.rep.dept.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_decide': 1}</field>
    </record>

    <record id="action_customer_complaint" model="ir.actions.act_window">
        <field name="name">Customer Complaints &amp; Requests</field>
        <field name="res_model">sales.rep.dept.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('category', '=', 'customer')]</field>
        <field name="context">{'search_default_to_decide': 1, 'search_default_group_type': 1}</field>
    </record>

    <menuitem id="menu_dept_request" name="Department Requests" parent="sales_rep_management.menu_sales_rep_operations"
              action="action_dept_request" sequence="13"/>
    <menuitem id="menu_customer_complaint" name="Customer Complaints" parent="sales_rep_management.menu_sales_rep_operations"
              action="action_customer_complaint" sequence="14"/>
    <menuitem id="menu_dept_request_type" name="Request Types" parent="sales_rep_management.menu_sales_rep_config"
              action="action_dept_request_type" sequence="6"/>
</odoo>
