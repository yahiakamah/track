<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manager_session_list" model="ir.ui.view">
        <field name="name">sales.rep.manager.session.list</field>
        <field name="model">sales.rep.manager.session</field>
        <field name="arch" type="xml">
            <list string="Manager App Sessions" create="0" edit="0">
                <field name="user_id"/>
                <field name="device_model"/>
                <field name="device_id" optional="hide"/>
                <field name="last_seen"/>
                <field name="expiry"/>
                <field name="active" widget="boolean_toggle" readonly="1"/>
                <button name="action_revoke" type="object" string="Revoke" icon="fa-ban" invisible="not active"/>
            </list>
        </field>
    </record>

    <record id="action_manager_sessions" model="ir.actions.act_window">
        <field name="name">Manager App Sessions</field>
        <field name="res_model">sales.rep.manager.session</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
        <field name="domain">[]</field>
    </record>

    <menuitem id="menu_manager_sessions" name="Manager App Sessions" parent="sales_rep_management.menu_sales_rep_config"
              action="action_manager_sessions" sequence="95" groups="sales_rep_management.group_sales_manager"/>

    <!-- last known position on the representative form -->
    <record id="view_sales_rep_form_position" model="ir.ui.view">
        <field name="name">sales.representative.form.position</field>
        <field name="model">sales.representative</field>
        <field name="inherit_id" ref="sales_rep_management.view_sales_representative_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Last Known Position" invisible="not last_location_at">
                    <field name="last_location_at"/>
                    <field name="last_latitude"/>
                    <field name="last_longitude"/>
                    <field name="last_location_source"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
