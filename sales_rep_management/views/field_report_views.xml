<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Visit Analysis ============ -->
    <record id="view_report_visit_list" model="ir.ui.view">
        <field name="name">sales.rep.report.visit.list</field>
        <field name="model">sales.rep.report.visit</field>
        <field name="arch" type="xml">
            <list string="Visit Analysis" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="sales_rep_id"/>
                <field name="supervisor_id" optional="hide"/>
                <field name="sales_area_id"/>
                <field name="partner_id"/>
                <field name="route_id" optional="hide"/>
                <field name="origin"/>
                <field name="status" widget="badge"/>
                <field name="visit_result"/>
                <field name="visit_type_id" optional="hide"/>
                <field name="start_time" optional="hide"/>
                <field name="end_time" optional="hide"/>
                <field name="duration_hours" sum="Total"/>
                <field name="order_count" sum="Total"/>
                <field name="sale_amount" sum="Total"/>
                <field name="collected_amount" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_report_visit_pivot" model="ir.ui.view">
        <field name="name">sales.rep.report.visit.pivot</field>
        <field name="model">sales.rep.report.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visit Analysis" sample="1">
                <field name="sales_rep_id" type="row"/>
                <field name="status" type="col"/>
                <field name="nbr_planned" type="measure"/>
                <field name="nbr_plan_done" type="measure"/>
                <field name="nbr_missed" type="measure"/>
                <field name="nbr_productive" type="measure"/>
                <field name="sale_amount" type="measure"/>
                <field name="collected_amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_report_visit_graph" model="ir.ui.view">
        <field name="name">sales.rep.report.visit.graph</field>
        <field name="model">sales.rep.report.visit</field>
        <field name="arch" type="xml">
            <graph string="Visit Analysis" type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="nbr_visited" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_report_visit_search" model="ir.ui.view">
        <field name="name">sales.rep.report.visit.search</field>
        <field name="model">sales.rep.report.visit</field>
        <field name="arch" type="xml">
            <search string="Visit Analysis">
                <field name="sales_rep_id"/>
                <field name="supervisor_id"/>
                <field name="sales_area_id" operator="child_of"/>
                <field name="partner_id" operator="child_of"/>
                <field name="route_id"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <separator/>
                <filter string="Planned" name="planned" domain="[('origin', '=', 'planned')]"/>
                <filter string="Unplanned" name="unplanned" domain="[('origin', '=', 'unplanned')]"/>
                <separator/>
                <filter string="Visited" name="visited" domain="[('status', '=', 'visited')]"/>
                <filter string="Missed" name="missed" domain="[('status', '=', 'missed')]"/>
                <filter string="Upcoming" name="upcoming" domain="[('status', '=', 'upcoming')]"/>
                <separator/>
                <filter string="Productive" name="productive" domain="[('nbr_productive', '=', 1)]"/>
                <filter string="Visited without Order" name="not_productive" domain="[('status', '=', 'visited'), ('nbr_productive', '=', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Representative" name="groupby_sales_rep_id" context="{'group_by': 'sales_rep_id'}"/>
                    <filter string="Supervisor" name="groupby_supervisor_id" context="{'group_by': 'supervisor_id'}"/>
                    <filter string="Area" name="groupby_sales_area_id" context="{'group_by': 'sales_area_id'}"/>
                    <filter string="Customer" name="groupby_partner_id" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="groupby_status" context="{'group_by': 'status'}"/>
                    <filter string="Origin" name="groupby_origin" context="{'group_by': 'origin'}"/>
                    <filter string="Visit Result" name="groupby_visit_result" context="{'group_by': 'visit_result'}"/>
                    <filter string="Visit Type" name="groupby_visit_type_id" context="{'group_by': 'visit_type_id'}"/>
                    <filter string="Route" name="groupby_route_id" context="{'group_by': 'route_id'}"/>
                    <filter string="Day" name="groupby_day" context="{'group_by': 'date:day'}"/>
                    <filter string="Week" name="groupby_week" context="{'group_by': 'date:week'}"/>
                    <filter string="Month" name="groupby_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_report_visits" model="ir.actions.act_window">
        <field name="name">Visit Analysis</field>
        <field name="res_model">sales.rep.report.visit</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_report_visit_search"/>
        <field name="context">{'search_default_filter_date': 1, 'search_default_visited': 1}</field>
    </record>
    <!-- ============ Sales Analysis ============ -->
    <record id="view_report_sale_list" model="ir.ui.view">
        <field name="name">sales.rep.report.sale.list</field>
        <field name="model">sales.rep.report.sale</field>
        <field name="arch" type="xml">
            <list string="Sales Analysis" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="order_id"/>
                <field name="sales_rep_id"/>
                <field name="sales_area_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="qty_ordered" sum="Total"/>
                <field name="qty_delivered" sum="Total"/>
                <field name="qty_invoiced" sum="Total" optional="hide"/>
                <field name="qty_free" sum="Total"/>
                <field name="discount_amount" sum="Total"/>
                <field name="amount_untaxed" sum="Total" optional="hide"/>
                <field name="amount_total" sum="Total" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="invoice_status"/>
            </list>
        </field>
    </record>
    <record id="view_report_sale_pivot" model="ir.ui.view">
        <field name="name">sales.rep.report.sale.pivot</field>
        <field name="model">sales.rep.report.sale</field>
        <field name="arch" type="xml">
            <pivot string="Sales Analysis" sample="1">
                <field name="sales_rep_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="amount_untaxed" type="measure"/>
                <field name="qty_ordered" type="measure"/>
                <field name="order_count" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_report_sale_graph" model="ir.ui.view">
        <field name="name">sales.rep.report.sale.graph</field>
        <field name="model">sales.rep.report.sale</field>
        <field name="arch" type="xml">
            <graph string="Sales Analysis" type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="amount_untaxed" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_report_sale_search" model="ir.ui.view">
        <field name="name">sales.rep.report.sale.search</field>
        <field name="model">sales.rep.report.sale</field>
        <field name="arch" type="xml">
            <search string="Sales Analysis">
                <field name="sales_rep_id"/>
                <field name="supervisor_id"/>
                <field name="sales_area_id" operator="child_of"/>
                <field name="partner_id" operator="child_of"/>
                <field name="route_id"/>
                <field name="product_id"/>
                <field name="categ_id"/>
                <field name="order_id"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <separator/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'sale')]"/>
                <filter string="Quotations" name="quotations" domain="[('state', 'in', ('draft', 'sent'))]"/>
                <separator/>
                <filter string="To Deliver" name="to_deliver" domain="[('qty_to_deliver', '>', 0), ('state', '=', 'sale')]"/>
                <filter string="To Invoice" name="to_invoice" domain="[('invoice_status', '=', 'to invoice')]"/>
                <separator/>
                <filter string="Free / Promotion" name="free" domain="[('is_free', '=', True)]"/>
                <filter string="Cash Orders" name="cash" domain="[('is_cash', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Representative" name="groupby_sales_rep_id" context="{'group_by': 'sales_rep_id'}"/>
                    <filter string="Supervisor" name="groupby_supervisor_id" context="{'group_by': 'supervisor_id'}"/>
                    <filter string="Area" name="groupby_sales_area_id" context="{'group_by': 'sales_area_id'}"/>
                    <filter string="Customer" name="groupby_partner_id" context="{'group_by': 'partner_id'}"/>
                    <filter string="Product" name="groupby_product_id" context="{'group_by': 'product_id'}"/>
                    <filter string="Product Category" name="groupby_categ_id" context="{'group_by': 'categ_id'}"/>
                    <filter string="Order" name="groupby_order_id" context="{'group_by': 'order_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Invoice Status" name="groupby_invoice_status" context="{'group_by': 'invoice_status'}"/>
                    <filter string="Day" name="groupby_day" context="{'group_by': 'date:day'}"/>
                    <filter string="Week" name="groupby_week" context="{'group_by': 'date:week'}"/>
                    <filter string="Month" name="groupby_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_report_sales" model="ir.actions.act_window">
        <field name="name">Sales Analysis</field>
        <field name="res_model">sales.rep.report.sale</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_report_sale_search"/>
        <field name="context">{'search_default_filter_date': 1, 'search_default_confirmed': 1}</field>
    </record>
    <!-- ============ Invoice and Debt Analysis ============ -->
    <record id="view_report_invoice_list" model="ir.ui.view">
        <field name="name">sales.rep.report.invoice.list</field>
        <field name="model">sales.rep.report.invoice</field>
        <field name="arch" type="xml">
            <list string="Invoice &amp; Debt Analysis" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="move_id"/>
                <field name="move_type"/>
                <field name="sales_rep_id"/>
                <field name="sales_area_id"/>
                <field name="partner_id"/>
                <field name="invoice_date_due"/>
                <field name="payment_state" widget="badge"/>
                <field name="aging" widget="badge"/>
                <field name="days_overdue"/>
                <field name="amount_untaxed" sum="Total" optional="hide"/>
                <field name="amount_total" sum="Total" optional="hide"/>
                <field name="amount_paid" sum="Total"/>
                <field name="amount_residual" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_report_invoice_pivot" model="ir.ui.view">
        <field name="name">sales.rep.report.invoice.pivot</field>
        <field name="model">sales.rep.report.invoice</field>
        <field name="arch" type="xml">
            <pivot string="Invoice &amp; Debt Analysis" sample="1">
                <field name="sales_rep_id" type="row"/>
                <field name="aging" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="amount_paid" type="measure"/>
                <field name="amount_residual" type="measure"/>
                <field name="amount_overdue" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_report_invoice_graph" model="ir.ui.view">
        <field name="name">sales.rep.report.invoice.graph</field>
        <field name="model">sales.rep.report.invoice</field>
        <field name="arch" type="xml">
            <graph string="Invoice &amp; Debt Analysis" type="bar" sample="1">
                <field name="aging"/>
                <field name="amount_residual" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_report_invoice_search" model="ir.ui.view">
        <field name="name">sales.rep.report.invoice.search</field>
        <field name="model">sales.rep.report.invoice</field>
        <field name="arch" type="xml">
            <search string="Invoice &amp; Debt Analysis">
                <field name="sales_rep_id"/>
                <field name="supervisor_id"/>
                <field name="sales_area_id" operator="child_of"/>
                <field name="partner_id" operator="child_of"/>
                <field name="route_id"/>
                <field name="move_id"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <separator/>
                <filter string="Invoices" name="invoices" domain="[('move_type', '=', 'out_invoice')]"/>
                <filter string="Credit Notes" name="refunds" domain="[('move_type', '=', 'out_refund')]"/>
                <separator/>
                <filter string="Unpaid" name="unpaid" domain="[('amount_residual', '!=', 0)]"/>
                <filter string="Overdue" name="overdue" domain="[('nbr_overdue', '=', 1)]"/>
                <filter string="Paid" name="paid" domain="[('payment_state', 'in', ('paid', 'in_payment'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Representative" name="groupby_sales_rep_id" context="{'group_by': 'sales_rep_id'}"/>
                    <filter string="Supervisor" name="groupby_supervisor_id" context="{'group_by': 'supervisor_id'}"/>
                    <filter string="Area" name="groupby_sales_area_id" context="{'group_by': 'sales_area_id'}"/>
                    <filter string="Customer" name="groupby_partner_id" context="{'group_by': 'partner_id'}"/>
                    <filter string="Aging" name="groupby_aging" context="{'group_by': 'aging'}"/>
                    <filter string="Payment Status" name="groupby_payment_state" context="{'group_by': 'payment_state'}"/>
                    <filter string="Type" name="groupby_move_type" context="{'group_by': 'move_type'}"/>
                    <filter string="Day" name="groupby_day" context="{'group_by': 'date:day'}"/>
                    <filter string="Week" name="groupby_week" context="{'group_by': 'date:week'}"/>
                    <filter string="Month" name="groupby_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_report_invoices" model="ir.actions.act_window">
        <field name="name">Invoice &amp; Debt Analysis</field>
        <field name="res_model">sales.rep.report.invoice</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_report_invoice_search"/>
        <field name="context">{'search_default_filter_date': 1}</field>
    </record>
    <!-- ============ Collection Analysis ============ -->
    <record id="view_report_collection_list" model="ir.ui.view">
        <field name="name">sales.rep.report.collection.list</field>
        <field name="model">sales.rep.report.collection</field>
        <field name="arch" type="xml">
            <list string="Collection Analysis" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="payment_id"/>
                <field name="sales_rep_id"/>
                <field name="sales_area_id"/>
                <field name="partner_id"/>
                <field name="route_id" optional="hide"/>
                <field name="journal_id"/>
                <field name="payment_method_line_id" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="on_route"/>
                <field name="handed_over"/>
                <field name="amount" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_report_collection_pivot" model="ir.ui.view">
        <field name="name">sales.rep.report.collection.pivot</field>
        <field name="model">sales.rep.report.collection</field>
        <field name="arch" type="xml">
            <pivot string="Collection Analysis" sample="1">
                <field name="sales_rep_id" type="row"/>
                <field name="journal_id" type="col"/>
                <field name="amount" type="measure"/>
                <field name="payment_count" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_report_collection_graph" model="ir.ui.view">
        <field name="name">sales.rep.report.collection.graph</field>
        <field name="model">sales.rep.report.collection</field>
        <field name="arch" type="xml">
            <graph string="Collection Analysis" type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_report_collection_search" model="ir.ui.view">
        <field name="name">sales.rep.report.collection.search</field>
        <field name="model">sales.rep.report.collection</field>
        <field name="arch" type="xml">
            <search string="Collection Analysis">
                <field name="sales_rep_id"/>
                <field name="supervisor_id"/>
                <field name="sales_area_id" operator="child_of"/>
                <field name="partner_id" operator="child_of"/>
                <field name="route_id"/>
                <field name="journal_id"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <separator/>
                <filter string="Cash" name="cash" domain="[('amount_cash', '!=', 0)]"/>
                <filter string="Bank / Other" name="bank" domain="[('amount_bank', '!=', 0)]"/>
                <separator/>
                <filter string="Cash Not Handed Over" name="not_handed" domain="[('amount_not_handed', '!=', 0)]"/>
                <filter string="During a Route" name="on_route" domain="[('on_route', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Representative" name="groupby_sales_rep_id" context="{'group_by': 'sales_rep_id'}"/>
                    <filter string="Supervisor" name="groupby_supervisor_id" context="{'group_by': 'supervisor_id'}"/>
                    <filter string="Area" name="groupby_sales_area_id" context="{'group_by': 'sales_area_id'}"/>
                    <filter string="Customer" name="groupby_partner_id" context="{'group_by': 'partner_id'}"/>
                    <filter string="Journal" name="groupby_journal_id" context="{'group_by': 'journal_id'}"/>
                    <filter string="Payment Method" name="groupby_payment_method_line_id" context="{'group_by': 'payment_method_line_id'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Day" name="groupby_day" context="{'group_by': 'date:day'}"/>
                    <filter string="Week" name="groupby_week" context="{'group_by': 'date:week'}"/>
                    <filter string="Month" name="groupby_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_report_collections" model="ir.actions.act_window">
        <field name="name">Collection Analysis</field>
        <field name="res_model">sales.rep.report.collection</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_report_collection_search"/>
        <field name="context">{'search_default_filter_date': 1}</field>
    </record>
    <!-- ============ Shipping and Delivery Analysis ============ -->
    <record id="view_report_delivery_list" model="ir.ui.view">
        <field name="name">sales.rep.report.delivery.list</field>
        <field name="model">sales.rep.report.delivery</field>
        <field name="arch" type="xml">
            <list string="Shipping &amp; Delivery Analysis" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="picking_id"/>
                <field name="sale_id"/>
                <field name="kind" widget="badge"/>
                <field name="sales_rep_id"/>
                <field name="sales_area_id"/>
                <field name="partner_id"/>
                <field name="state" widget="badge"/>
                <field name="load_acceptance_state" optional="hide"/>
                <field name="scheduled_date"/>
                <field name="date_done"/>
                <field name="is_late"/>
                <field name="is_backorder"/>
                <field name="qty_demand" sum="Total"/>
                <field name="qty_done" sum="Total"/>
                <field name="delay_hours" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_report_delivery_pivot" model="ir.ui.view">
        <field name="name">sales.rep.report.delivery.pivot</field>
        <field name="model">sales.rep.report.delivery</field>
        <field name="arch" type="xml">
            <pivot string="Shipping &amp; Delivery Analysis" sample="1">
                <field name="sales_rep_id" type="row"/>
                <field name="kind" type="col"/>
                <field name="picking_count" type="measure"/>
                <field name="nbr_done" type="measure"/>
                <field name="nbr_late" type="measure"/>
                <field name="qty_demand" type="measure"/>
                <field name="qty_done" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_report_delivery_graph" model="ir.ui.view">
        <field name="name">sales.rep.report.delivery.graph</field>
        <field name="model">sales.rep.report.delivery</field>
        <field name="arch" type="xml">
            <graph string="Shipping &amp; Delivery Analysis" type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="picking_count" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_report_delivery_search" model="ir.ui.view">
        <field name="name">sales.rep.report.delivery.search</field>
        <field name="model">sales.rep.report.delivery</field>
        <field name="arch" type="xml">
            <search string="Shipping &amp; Delivery Analysis">
                <field name="sales_rep_id"/>
                <field name="supervisor_id"/>
                <field name="sales_area_id" operator="child_of"/>
                <field name="partner_id" operator="child_of"/>
                <field name="route_id"/>
                <field name="picking_id"/>
                <field name="sale_id"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <separator/>
                <filter string="Deliveries" name="deliveries" domain="[('kind', '=', 'delivery')]"/>
                <filter string="Customer Returns" name="returns" domain="[('kind', '=', 'return')]"/>
                <filter string="Van Loads" name="van_loads" domain="[('kind', '=', 'van_load')]"/>
                <separator/>
                <filter string="Open" name="open" domain="[('nbr_open', '=', 1)]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Late" name="late" domain="[('is_late', '=', True)]"/>
                <filter string="Backorders" name="backorders" domain="[('is_backorder', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Representative" name="groupby_sales_rep_id" context="{'group_by': 'sales_rep_id'}"/>
                    <filter string="Supervisor" name="groupby_supervisor_id" context="{'group_by': 'supervisor_id'}"/>
                    <filter string="Area" name="groupby_sales_area_id" context="{'group_by': 'sales_area_id'}"/>
                    <filter string="Customer" name="groupby_partner_id" context="{'group_by': 'partner_id'}"/>
                    <filter string="Type" name="groupby_kind" context="{'group_by': 'kind'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Load Acceptance" name="groupby_load_acceptance_state" context="{'group_by': 'load_acceptance_state'}"/>
                    <filter string="Return Reason" name="groupby_return_reason_id" context="{'group_by': 'return_reason_id'}"/>
                    <filter string="Sales Order" name="groupby_sale_id" context="{'group_by': 'sale_id'}"/>
                    <filter string="Day" name="groupby_day" context="{'group_by': 'date:day'}"/>
                    <filter string="Week" name="groupby_week" context="{'group_by': 'date:week'}"/>
                    <filter string="Month" name="groupby_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_report_deliveries" model="ir.actions.act_window">
        <field name="name">Shipping &amp; Delivery Analysis</field>
        <field name="res_model">sales.rep.report.delivery</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_report_delivery_search"/>
        <field name="context">{'search_default_filter_date': 1}</field>
    </record>
    <!-- ============ Task Analysis ============ -->
    <record id="view_report_task_list" model="ir.ui.view">
        <field name="name">sales.rep.report.task.list</field>
        <field name="model">sales.rep.report.task</field>
        <field name="arch" type="xml">
            <list string="Task Analysis" create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="task_id"/>
                <field name="task_type"/>
                <field name="sales_rep_id"/>
                <field name="sales_area_id"/>
                <field name="partner_id"/>
                <field name="route_id" optional="hide"/>
                <field name="priority"/>
                <field name="state" widget="badge"/>
                <field name="source" optional="hide"/>
                <field name="done_date"/>
                <field name="days_late"/>
                <field name="amount_due" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_report_task_pivot" model="ir.ui.view">
        <field name="name">sales.rep.report.task.pivot</field>
        <field name="model">sales.rep.report.task</field>
        <field name="arch" type="xml">
            <pivot string="Task Analysis" sample="1">
                <field name="sales_rep_id" type="row"/>
                <field name="state" type="col"/>
                <field name="task_count" type="measure"/>
                <field name="nbr_done" type="measure"/>
                <field name="nbr_overdue" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_report_task_graph" model="ir.ui.view">
        <field name="name">sales.rep.report.task.graph</field>
        <field name="model">sales.rep.report.task</field>
        <field name="arch" type="xml">
            <graph string="Task Analysis" type="bar" sample="1">
                <field name="task_type"/>
                <field name="task_count" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_report_task_search" model="ir.ui.view">
        <field name="name">sales.rep.report.task.search</field>
        <field name="model">sales.rep.report.task</field>
        <field name="arch" type="xml">
            <search string="Task Analysis">
                <field name="sales_rep_id"/>
                <field name="supervisor_id"/>
                <field name="sales_area_id" operator="child_of"/>
                <field name="partner_id" operator="child_of"/>
                <field name="route_id"/>
                <field name="task_id"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <separator/>
                <filter string="Open" name="open" domain="[('nbr_open', '=', 1)]"/>
                <filter string="Overdue" name="overdue" domain="[('nbr_overdue', '=', 1)]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter string="From Overdue Rule" name="auto" domain="[('source', '=', 'auto_overdue')]"/>
                <filter string="Urgent" name="urgent" domain="[('priority', '=', '2')]"/>
                <group expand="0" string="Group By">
                    <filter string="Representative" name="groupby_sales_rep_id" context="{'group_by': 'sales_rep_id'}"/>
                    <filter string="Supervisor" name="groupby_supervisor_id" context="{'group_by': 'supervisor_id'}"/>
                    <filter string="Area" name="groupby_sales_area_id" context="{'group_by': 'sales_area_id'}"/>
                    <filter string="Customer" name="groupby_partner_id" context="{'group_by': 'partner_id'}"/>
                    <filter string="Task Type" name="groupby_task_type" context="{'group_by': 'task_type'}"/>
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Priority" name="groupby_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Source" name="groupby_source" context="{'group_by': 'source'}"/>
                    <filter string="Assigned By" name="groupby_assigned_by" context="{'group_by': 'assigned_by'}"/>
                    <filter string="Day" name="groupby_day" context="{'group_by': 'date:day'}"/>
                    <filter string="Week" name="groupby_week" context="{'group_by': 'date:week'}"/>
                    <filter string="Month" name="groupby_month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_report_tasks" model="ir.actions.act_window">
        <field name="name">Task Analysis</field>
        <field name="res_model">sales.rep.report.task</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_report_task_search"/>
        <field name="context">{'search_default_filter_date': 1}</field>
    </record>

    <!-- ============ Field activity report (filters → PDF / Excel / analysis) ============ -->
    <record id="view_field_report_wizard_form" model="ir.ui.view">
        <field name="name">sales.rep.field.report.wizard.form</field>
        <field name="model">sales.rep.field.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Field Activity Report">
                <group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="group_by"/>
                    </group>
                    <group string="Scope">
                        <field name="supervisor_id"/>
                        <field name="sales_rep_ids" widget="many2many_tags"/>
                        <field name="area_ids" widget="many2many_tags"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="partner_category_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <group>
                    <group string="Sections">
                        <field name="include_visits"/>
                        <field name="include_sales"/>
                        <field name="include_invoices"/>
                        <field name="include_collections"/>
                        <field name="include_deliveries"/>
                        <field name="include_tasks"/>
                    </group>
                    <group string="Details">
                        <field name="show_details"/>
                        <field name="detail_limit" invisible="not show_details"/>
                    </group>
                </group>
                <separator string="Interactive Analysis (same filters)"/>
                <div class="d-flex flex-wrap gap-2">
                    <button name="action_open_visits" type="object" string="Visits" icon="fa-map-marker" class="btn-secondary"/>
                    <button name="action_open_sales" type="object" string="Sales" icon="fa-shopping-cart" class="btn-secondary"/>
                    <button name="action_open_invoices" type="object" string="Invoices &amp; Debts" icon="fa-file-text-o" class="btn-secondary"/>
                    <button name="action_open_collections" type="object" string="Collections" icon="fa-money" class="btn-secondary"/>
                    <button name="action_open_deliveries" type="object" string="Shipping &amp; Delivery" icon="fa-truck" class="btn-secondary"/>
                    <button name="action_open_tasks" type="object" string="Tasks" icon="fa-check-square-o" class="btn-secondary"/>
                </div>
                <footer>
                    <button name="action_print_pdf" type="object" string="Print PDF" icon="fa-print" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel" icon="fa-file-excel-o" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_field_report_wizard" model="ir.actions.act_window">
        <field name="name">Field Activity Report</field>
        <field name="res_model">sales.rep.field.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============ Menus ============ -->
    <menuitem id="menu_field_reports" name="Field Reports" parent="sales_rep_management.menu_sales_rep_reports" sequence="0"/>
    <menuitem id="menu_field_report_wizard" name="Field Activity Report (PDF / Excel)" parent="menu_field_reports"
              action="action_field_report_wizard" sequence="1"/>
    <menuitem id="menu_report_visits" name="Visits" parent="menu_field_reports" action="action_report_visits" sequence="10"/>
    <menuitem id="menu_report_sales" name="Sales" parent="menu_field_reports" action="action_report_sales" sequence="20"/>
    <menuitem id="menu_report_invoices" name="Invoices &amp; Debts" parent="menu_field_reports" action="action_report_invoices" sequence="30"/>
    <menuitem id="menu_report_collections" name="Collections" parent="menu_field_reports" action="action_report_collections" sequence="40"/>
    <menuitem id="menu_report_deliveries" name="Shipping &amp; Delivery" parent="menu_field_reports" action="action_report_deliveries" sequence="50"/>
    <menuitem id="menu_report_tasks" name="Tasks" parent="menu_field_reports" action="action_report_tasks" sequence="60"/>
</odoo>
