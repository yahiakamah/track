<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Sales Rep Management Categories -->
        <record id="module_category_sales_rep" model="ir.module.category">
            <field name="name">Sales Rep Management</field>
            <field name="description">Manage sales representatives, routes and visits</field>
            <field name="sequence">10</field>
        </record>

        <!-- Sales Representative Group -->
        <record id="group_sales_rep_user" model="res.groups">
            <field name="name">Sales Representative</field>
            <field name="category_id" ref="module_category_sales_rep"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Sales representatives can view their routes and record visits</field>
        </record>

        <!-- Sales Supervisor Group -->
        <record id="group_sales_supervisor" model="res.groups">
            <field name="name">Sales Supervisor</field>
            <field name="category_id" ref="module_category_sales_rep"/>
            <field name="implied_ids" eval="[(4, ref('group_sales_rep_user'))]"/>
            <field name="comment">Supervisors can manage their team's routes and approve reports</field>
        </record>

        <!-- Sales Manager Group -->
        <record id="group_sales_manager" model="res.groups">
            <field name="name">Sales Manager</field>
            <field name="category_id" ref="module_category_sales_rep"/>
            <field name="implied_ids" eval="[(4, ref('group_sales_supervisor'))]"/>
            <field name="comment">Sales managers have full access to all sales rep management features</field>
        </record>

        <!-- Finance Access Group for Collections -->
        <record id="group_finance_collections" model="res.groups">
            <field name="name">Finance - Collections Access</field>
            <field name="category_id" ref="module_category_sales_rep"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Finance team can view and manage collection data</field>
        </record>
    </data>

